{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "On-call queue: model and data health",
  "uid": "oncall-queue-health",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "oncall-queue"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "stat",
      "title": "Healthy (1 = all checks pass)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "oncall_health_ok",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Model age (days)",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "oncall_model_age_days",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Retrain due",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "oncall_model_retrain_due",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Input drift warning",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "oncall_input_drift_warn",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Challenger jobs tallied",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "oncall_challenger_jobs",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "stat",
      "title": "Challenger saving (cost units)",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "oncall_challenger_cost_saving",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "timeseries",
      "title": "Precision from on-call marks",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "oncall_precision_from_marks",
          "legendFormat": "precision",
          "refId": "A"
        },
        {
          "expr": "oncall_feedback_marks",
          "legendFormat": "marks",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "timeseries",
      "title": "Input drift: largest PSI and text-classifier AUC",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "oncall_input_drift_psi_max",
          "legendFormat": "max PSI (warn at 0.25)",
          "refId": "A"
        },
        {
          "expr": "oncall_input_text_drift_auc",
          "legendFormat": "text AUC (warn at 0.75)",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "timeseries",
      "title": "Retrains by outcome",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(oncall_retrain_total[1d]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "timeseries",
      "title": "Alert volume vs earlier jobs",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "oncall_alert_volume_ratio",
          "legendFormat": "last batch / median",
          "refId": "A"
        },
        {
          "expr": "oncall_metric_median_ratio",
          "legendFormat": "metric median ratio",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "type": "timeseries",
      "title": "Request latency p95 (s)",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(oncall_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Pages and monitoring gaps",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "increase(oncall_pages_total[1h])",
          "legendFormat": "pages",
          "refId": "A"
        },
        {
          "expr": "oncall_last_job_gap_items",
          "legendFormat": "gap items shown",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    }
  ]
}
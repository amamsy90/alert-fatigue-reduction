# Production: copy to deploy/prod.env (git-ignored) and fill in. Never commit secrets.
# ENV_FILE=deploy/prod.env docker compose up -d
SHADOW_MODE=1               # stays on until the team types LIVE after a shadow period
APP_USER=oncall
APP_PASSWORD=               # required: Live mode and proxied access refuse to work without it
INGEST_TOKEN=               # Alertmanager sends it as a Bearer token
ALLOWED_HOSTS=              # e.g. oncall.example.internal
PROM_URL=
PROM_ALLOW_PRIVATE=0        # 1 only if Prometheus is on a trusted private network
# PAGERDUTY_ROUTING_KEY=
# SLACK_WEBHOOK_URL=
# OPSGENIE_API_KEY=
JOB_RETENTION=200
EVAL_RETENTION=30
INGEST_DEDUP_HOURS=24

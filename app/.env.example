# Copy to .env and fill in. Never commit real secrets.
# Shadow stays on until you type LIVE in the UI with at least one channel.

APP_USER=oncall
APP_PASSWORD=
INGEST_TOKEN=
# PAGERDUTY_ROUTING_KEY=
# SLACK_WEBHOOK_URL=
# OPSGENIE_API_KEY=
# OPSGENIE_API_URL=https://api.eu.opsgenie.com
# PROM_URL=http://host.docker.internal:9090
# 1 = allow a private/loopback Prometheus (in-cluster). Off by default (SSRF).
PROM_ALLOW_PRIVATE=0
# Extra Host names the app answers to without a password (DNS-rebinding guard).
# ALLOWED_HOSTS=oncall.internal
# ALLOW_OPEN_ACCESS=0
SHADOW_MODE=1
